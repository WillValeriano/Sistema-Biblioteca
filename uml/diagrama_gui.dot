digraph UML {
graph [rankdir=BT, splines=spline, nodesep=0.5, ranksep=0.7, fontname="Helvetica", label=<<B>Gestión de Biblioteca — Paquete gui (Swing)</B><BR/><FONT POINT-SIZE="11">Patrones: Observer (BibliotecaListener) · Template Method (PanelListado, DialogoBase) · Modelo genérico de tabla</FONT>>, labelloc=t, fontsize=18, pad=0.4];
node [shape=plaintext, fontname="Helvetica", fontsize=10];
edge [fontname="Helvetica", fontsize=9, color="#1F3A5F"];
"Main" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="5"><B>Main</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="2"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><U>+ main(args: String[]) {static}</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"BibliotecaListener" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#E8F1F8" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#555555">«interface»</FONT><BR/><B><I>BibliotecaListener</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ bibliotecaCambio(descripcion: String)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Actualizable" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#E8F1F8" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#555555">«interface»</FONT><BR/><B><I>Actualizable</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ actualizar()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Biblioteca" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#E6F4EA" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#555555">«Facade»</FONT><BR/><B>Biblioteca</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="2"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">(ver diagrama del dominio)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"VentanaPrincipal" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="5"><B>VentanaPrincipal</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- biblioteca: Biblioteca<BR ALIGN="LEFT"/>- persistencia: GestorPersistencia<BR ALIGN="LEFT"/>- pantallas: List&lt;Actualizable&gt;<BR ALIGN="LEFT"/>- tarjetas: CardLayout<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ bibliotecaCambio(descripcion: String)<BR ALIGN="LEFT"/>+ mostrarSeccion(nombre: String)<BR ALIGN="LEFT"/>- actualizarTodo()<BR ALIGN="LEFT"/>- guardar()<BR ALIGN="LEFT"/>- crearMenu(): JMenuBar<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"PanelListado" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#EEF0F7" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#555555">«abstract»</FONT><BR/><B><I>PanelListado&lt;T&gt;</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"># biblioteca: Biblioteca<BR ALIGN="LEFT"/># modelo: ModeloTabla&lt;T&gt;<BR ALIGN="LEFT"/># tabla: JTable<BR ALIGN="LEFT"/>- sorter: TableRowSorter<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><I># definirColumnas(m: ModeloTabla&lt;T&gt;) {abstract}</I><BR ALIGN="LEFT"/><I># obtenerDatos(): List&lt;T&gt; {abstract}</I><BR ALIGN="LEFT"/><I># coincide(fila: T, texto: String): boolean {abstract}</I><BR ALIGN="LEFT"/># pasaFiltroExtra(fila: T): boolean<BR ALIGN="LEFT"/># alDobleClic(fila: T)<BR ALIGN="LEFT"/>+ actualizar()<BR ALIGN="LEFT"/># aplicarFiltro()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"PanelCatalogo" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="5"><B>PanelCatalogo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="2"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"># definirColumnas(...)<BR ALIGN="LEFT"/># obtenerDatos(): List&lt;MaterialBibliografico&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"PanelSocios" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="5"><B>PanelSocios</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="2"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"># definirColumnas(...)<BR ALIGN="LEFT"/># obtenerDatos(): List&lt;Socio&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"PanelPrestamos" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="5"><B>PanelPrestamos</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="2"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"># definirColumnas(...)<BR ALIGN="LEFT"/># obtenerDatos(): List&lt;Prestamo&gt;<BR ALIGN="LEFT"/>- devolver(p: Prestamo)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"PanelMultas" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="5"><B>PanelMultas</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="2"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"># definirColumnas(...)<BR ALIGN="LEFT"/># obtenerDatos(): List&lt;Multa&gt;<BR ALIGN="LEFT"/>- pagar(m: Multa)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"PanelInicio" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="5"><B>PanelInicio</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- tarjetas: TarjetaEstadistica[5]<BR ALIGN="LEFT"/>- grafico: GraficoBarras<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ actualizar()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ModeloTabla" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="5"><B>ModeloTabla&lt;T&gt;</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- columnas: List&lt;Columna&lt;T&gt;&gt;<BR ALIGN="LEFT"/>- filas: List&lt;T&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ columna(nombre, tipo, ancho, extractor: Function&lt;T,Object&gt;): ModeloTabla&lt;T&gt;<BR ALIGN="LEFT"/>+ setFilas(filas: List&lt;T&gt;)<BR ALIGN="LEFT"/>+ getFila(i: int): T<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"DialogoBase" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#EEF0F7" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#555555">«abstract»</FONT><BR/><B><I>DialogoBase</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"># cuerpo: JPanel<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><I># aceptar() {abstract}</I><BR ALIGN="LEFT"/># agregarCampo(etiqueta, campo)<BR ALIGN="LEFT"/># mostrar()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
