digraph UML {
graph [rankdir=BT, splines=spline, nodesep=0.55, ranksep=0.75, fontname="Helvetica", label=<<B>Gestión de Biblioteca — Diagrama de Clases UML</B><BR/><FONT POINT-SIZE="11">Proyecto Final Integrador · Lenguajes 2 · Ingeniería en Informática</FONT>>, labelloc=t, fontsize=20, pad=0.4];
node [shape=plaintext, fontname="Helvetica", fontsize=10];
edge [fontname="Helvetica", fontsize=9, color="#1F3A5F"];
subgraph cluster_personas { label="Personas (paquete modelo)"; style="rounded,dashed"; color="#9AA8B8"; fontsize=12; fontcolor="#556070";
"Persona" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#EEF0F7" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#555555">«abstract»</FONT><BR/><B><I>Persona</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- dni: String<BR ALIGN="LEFT"/>- nombre: String<BR ALIGN="LEFT"/>- apellido: String<BR ALIGN="LEFT"/>- email: String<BR ALIGN="LEFT"/>- telefono: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><I>+ getRol(): String {abstract}</I><BR ALIGN="LEFT"/>+ getNombreCompleto(): String<BR ALIGN="LEFT"/>+ coincideCon(texto: String): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Bibliotecario" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="5"><B>Bibliotecario</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- legajo: String<BR ALIGN="LEFT"/>- turno: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ getId(): String<BR ALIGN="LEFT"/>+ getRol(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Socio" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#EEF0F7" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#555555">«abstract»</FONT><BR/><B><I>Socio</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- numeroSocio: String<BR ALIGN="LEFT"/>- fechaAlta: LocalDate<BR ALIGN="LEFT"/>- activo: boolean<BR ALIGN="LEFT"/>- prestamos: List&lt;Prestamo&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><I>+ getMaxPrestamos(): int {abstract}</I><BR ALIGN="LEFT"/><I>+ getDiasPrestamo(): int {abstract}</I><BR ALIGN="LEFT"/><I>+ getDescuentoMulta(): double {abstract}</I><BR ALIGN="LEFT"/><I>+ getTipo(): String {abstract}</I><BR ALIGN="LEFT"/>+ verificarHabilitado(hoy: LocalDate)<BR ALIGN="LEFT"/>+ getEstado(hoy: LocalDate): String<BR ALIGN="LEFT"/>+ getPrestamosActivos(): List&lt;Prestamo&gt;<BR ALIGN="LEFT"/>+ getDeudaPendiente(): double<BR ALIGN="LEFT"/>~ agregarPrestamo(p: Prestamo)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"SocioEstudiante" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="5"><B>SocioEstudiante</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- carrera: String<BR ALIGN="LEFT"/>- legajoUniversitario: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ getMaxPrestamos(): int  → 3<BR ALIGN="LEFT"/>+ getDiasPrestamo(): int  → 7<BR ALIGN="LEFT"/>+ getDescuentoMulta(): double  → 0.50<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"SocioDocente" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="5"><B>SocioDocente</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- departamento: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ getMaxPrestamos(): int  → 5<BR ALIGN="LEFT"/>+ getDiasPrestamo(): int  → 14<BR ALIGN="LEFT"/>+ getDescuentoMulta(): double  → 0.25<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"SocioGeneral" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="5"><B>SocioGeneral</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="2"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ getMaxPrestamos(): int  → 2<BR ALIGN="LEFT"/>+ getDiasPrestamo(): int  → 10<BR ALIGN="LEFT"/>+ getDescuentoMulta(): double  → 0<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
subgraph cluster_catalogo { label="Catálogo (paquete modelo)"; style="rounded,dashed"; color="#9AA8B8"; fontsize=12; fontcolor="#556070";
"MaterialBibliografico" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#EEF0F7" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#555555">«abstract»</FONT><BR/><B><I>MaterialBibliografico</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- codigo: String<BR ALIGN="LEFT"/>- titulo: String<BR ALIGN="LEFT"/>- anioPublicacion: int<BR ALIGN="LEFT"/>- categoria: String<BR ALIGN="LEFT"/>- vecesPrestado: int<BR ALIGN="LEFT"/>- ejemplares: List&lt;Ejemplar&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><I>+ getTipo(): String {abstract}</I><BR ALIGN="LEFT"/><I>+ getPlazoMaximoDias(): int {abstract}</I><BR ALIGN="LEFT"/><I>+ getDetalle(): String {abstract}</I><BR ALIGN="LEFT"/>+ agregarEjemplar(ubicacion: String): Ejemplar<BR ALIGN="LEFT"/>+ primerEjemplarDisponible(): Optional&lt;Ejemplar&gt;<BR ALIGN="LEFT"/>+ getCantidadDisponibles(): int<BR ALIGN="LEFT"/>+ tieneEjemplaresPrestados(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Libro" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="5"><B>Libro</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- isbn: String<BR ALIGN="LEFT"/>- editorial: String<BR ALIGN="LEFT"/>- autores: List&lt;Autor&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ getPlazoMaximoDias(): int  → 30<BR ALIGN="LEFT"/>+ getDetalle(): String<BR ALIGN="LEFT"/>+ getAutores(): List&lt;Autor&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Revista" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="5"><B>Revista</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- issn: String<BR ALIGN="LEFT"/>- numero: int<BR ALIGN="LEFT"/>- periodicidad: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ getPlazoMaximoDias(): int  → 3<BR ALIGN="LEFT"/>+ getDetalle(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Autor" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="5"><B>Autor</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- id: String<BR ALIGN="LEFT"/>- nombre: String<BR ALIGN="LEFT"/>- nacionalidad: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ getId(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Ejemplar" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="5"><B>Ejemplar</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- codigo: String<BR ALIGN="LEFT"/>- material: MaterialBibliografico<BR ALIGN="LEFT"/>- estado: EstadoEjemplar<BR ALIGN="LEFT"/>- ubicacion: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">~ Ejemplar(codigo, material, ubicacion)<BR ALIGN="LEFT"/>+ estaDisponible(): boolean<BR ALIGN="LEFT"/>+ prestar()<BR ALIGN="LEFT"/>+ devolver()<BR ALIGN="LEFT"/>+ cambiarReparacion()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"EstadoEjemplar" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#F3EEE0" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#555555">«enumeration»</FONT><BR/><B>EstadoEjemplar</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">DISPONIBLE<BR ALIGN="LEFT"/>PRESTADO<BR ALIGN="LEFT"/>EN_REPARACION<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
subgraph cluster_prestamos { label="Préstamos y multas (paquetes modelo y multas)"; style="rounded,dashed"; color="#9AA8B8"; fontsize=12; fontcolor="#556070";
"Prestamo" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="5"><B>Prestamo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><U>+ MAX_RENOVACIONES: int = 1 {static}</U><BR ALIGN="LEFT"/>- id: String<BR ALIGN="LEFT"/>- socio: Socio<BR ALIGN="LEFT"/>- ejemplar: Ejemplar<BR ALIGN="LEFT"/>- bibliotecario: Bibliotecario<BR ALIGN="LEFT"/>- fechaPrestamo: LocalDate<BR ALIGN="LEFT"/>- fechaVencimiento: LocalDate<BR ALIGN="LEFT"/>- fechaDevolucion: LocalDate<BR ALIGN="LEFT"/>- renovaciones: int<BR ALIGN="LEFT"/>- multa: Multa<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ Prestamo(id, socio, ejemplar, bibliotecario, fecha)<BR ALIGN="LEFT"/>+ registrarDevolucion(idMulta, fecha, politica: PoliticaMulta): Multa<BR ALIGN="LEFT"/>+ renovar(hoy: LocalDate)<BR ALIGN="LEFT"/>+ getEstado(hoy: LocalDate): EstadoPrestamo<BR ALIGN="LEFT"/>+ getDiasAtraso(ref: LocalDate): int<BR ALIGN="LEFT"/>+ estaDevuelto(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Multa" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="5"><B>Multa</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- id: String<BR ALIGN="LEFT"/>- diasAtraso: int<BR ALIGN="LEFT"/>- monto: double<BR ALIGN="LEFT"/>- fechaGeneracion: LocalDate<BR ALIGN="LEFT"/>- fechaPago: LocalDate<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">~ Multa(id, prestamo, dias, monto, fecha)<BR ALIGN="LEFT"/>+ pagar(fecha: LocalDate)<BR ALIGN="LEFT"/>+ estaPagada(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"EstadoPrestamo" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#F3EEE0" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#555555">«enumeration»</FONT><BR/><B>EstadoPrestamo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">ACTIVO<BR ALIGN="LEFT"/>VENCIDO<BR ALIGN="LEFT"/>DEVUELTO<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"PoliticaMulta" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#E8F1F8" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#555555">«interface»</FONT><BR/><B><I>PoliticaMulta</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ calcular(diasAtraso: int): double<BR ALIGN="LEFT"/>+ getNombre(): String<BR ALIGN="LEFT"/>+ getDescripcion(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"MultaFijaDiaria" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="5"><B>MultaFijaDiaria</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- montoPorDia: double<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ calcular(diasAtraso: int): double<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"MultaProgresiva" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="5"><B>MultaProgresiva</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- montoBase: double<BR ALIGN="LEFT"/>- incrementoSemanal: double<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ calcular(diasAtraso: int): double<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
subgraph cluster_servicio { label="Servicio y persistencia"; style="rounded,dashed"; color="#9AA8B8"; fontsize=12; fontcolor="#556070";
"Biblioteca" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#E6F4EA" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#555555">«Facade»</FONT><BR/><B>Biblioteca</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- nombre: String<BR ALIGN="LEFT"/>- materiales: Repositorio&lt;MaterialBibliografico&gt;<BR ALIGN="LEFT"/>- socios: Repositorio&lt;Socio&gt;<BR ALIGN="LEFT"/>- prestamos: Repositorio&lt;Prestamo&gt;<BR ALIGN="LEFT"/>- autores: Repositorio&lt;Autor&gt;<BR ALIGN="LEFT"/>- bibliotecarios: Repositorio&lt;Bibliotecario&gt;<BR ALIGN="LEFT"/>- politicaMulta: PoliticaMulta<BR ALIGN="LEFT"/>- bibliotecarioActual: Bibliotecario<BR ALIGN="LEFT"/>- desplazamientoDias: int<BR ALIGN="LEFT"/>- listeners: List&lt;BibliotecaListener&gt; {transient}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ registrarLibro(...): Libro<BR ALIGN="LEFT"/>+ registrarRevista(...): Revista<BR ALIGN="LEFT"/>+ registrarEstudiante(...) / registrarDocente(...) / registrarGeneral(...)<BR ALIGN="LEFT"/>+ prestar(socio: Socio, material: MaterialBibliografico): Prestamo<BR ALIGN="LEFT"/>+ devolver(p: Prestamo): Multa<BR ALIGN="LEFT"/>+ renovar(p: Prestamo)<BR ALIGN="LEFT"/>+ pagarMulta(m: Multa)<BR ALIGN="LEFT"/>+ buscarMateriales(texto: String): List<BR ALIGN="LEFT"/>+ masPrestados(n: int): List<BR ALIGN="LEFT"/>+ setPoliticaMulta(p: PoliticaMulta)<BR ALIGN="LEFT"/>+ hoy(): LocalDate<BR ALIGN="LEFT"/>+ avanzarDias(dias: int)<BR ALIGN="LEFT"/>+ agregarListener(l: BibliotecaListener)<BR ALIGN="LEFT"/>- notificar(cambio: String)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"BibliotecaListener" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#E8F1F8" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#555555">«interface»</FONT><BR/><B><I>BibliotecaListener</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ bibliotecaCambio(descripcion: String)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Repositorio" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#E8F1F8" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#555555">«interface»</FONT><BR/><B><I>Repositorio&lt;T extends Identificable&gt;</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ guardar(entidad: T)<BR ALIGN="LEFT"/>+ eliminar(id: String): boolean<BR ALIGN="LEFT"/>+ buscarPorId(id: String): Optional&lt;T&gt;<BR ALIGN="LEFT"/>+ listar(): List&lt;T&gt;<BR ALIGN="LEFT"/>+ filtrar(criterio: Predicate&lt;T&gt;): List&lt;T&gt;<BR ALIGN="LEFT"/>+ cantidad(): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"RepositorioMemoria" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="5"><B>RepositorioMemoria&lt;T&gt;</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- datos: Map&lt;String, T&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ guardar(entidad: T)<BR ALIGN="LEFT"/>+ buscarPorId(id): Optional&lt;T&gt;<BR ALIGN="LEFT"/>+ filtrar(criterio): List&lt;T&gt;<BR ALIGN="LEFT"/>...<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"GestorPersistencia" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#FFFFFF" CELLPADDING="5"><B>GestorPersistencia</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">- archivo: Path<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ guardar(b: Biblioteca)<BR ALIGN="LEFT"/>+ cargar(): Biblioteca<BR ALIGN="LEFT"/>+ existeArchivo(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"OperacionInvalidaException" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#FBEAEA" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#555555">«exception»</FONT><BR/><B>OperacionInvalidaException</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="2"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ OperacionInvalidaException(mensaje: String)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
"Identificable" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#E8F1F8" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#555555">«interface»</FONT><BR/><B><I>Identificable</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ getId(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Buscable" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#E8F1F8" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#555555">«interface»</FONT><BR/><B><I>Buscable</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ coincideCon(texto: String): boolean<BR ALIGN="LEFT"/><U>+ normalizar(texto: String): String {static}</U><BR ALIGN="LEFT"/><U>+ contieneAlguno(texto, campos...): boolean {static}</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Prestable" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#1F3A5F"><TR><TD BGCOLOR="#E8F1F8" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#555555">«interface»</FONT><BR/><B><I>Prestable</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+ estaDisponible(): boolean<BR ALIGN="LEFT"/>+ prestar() {throws OperacionInvalidaException}<BR ALIGN="LEFT"/>+ devolver()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Bibliotecario" -> "Persona" [arrowhead=empty, arrowsize=1.2];
"Socio" -> "Persona" [arrowhead=empty, arrowsize=1.2];
"SocioEstudiante" -> "Socio" [arrowhead=empty, arrowsize=1.2];
"SocioDocente" -> "Socio" [arrowhead=empty, arrowsize=1.2];
"SocioGeneral" -> "Socio" [arrowhead=empty, arrowsize=1.2];
"Libro" -> "MaterialBibliografico" [arrowhead=empty, arrowsize=1.2];
"Revista" -> "MaterialBibliografico" [arrowhead=empty, arrowsize=1.2];
"Persona" -> "Identificable" [arrowhead=empty, style=dashed, arrowsize=1.2];
"Persona" -> "Buscable" [arrowhead=empty, style=dashed, arrowsize=1.2];
"MaterialBibliografico" -> "Identificable" [arrowhead=empty, style=dashed, arrowsize=1.2];
"MaterialBibliografico" -> "Buscable" [arrowhead=empty, style=dashed, arrowsize=1.2];
"Ejemplar" -> "Prestable" [arrowhead=empty, style=dashed, arrowsize=1.2];
"Ejemplar" -> "Identificable" [arrowhead=empty, style=dashed, arrowsize=1.2, color="#A7B3C2"];
"Prestamo" -> "Identificable" [arrowhead=empty, style=dashed, arrowsize=1.2, color="#A7B3C2"];
"Multa" -> "Identificable" [arrowhead=empty, style=dashed, arrowsize=1.2, color="#A7B3C2"];
"Autor" -> "Identificable" [arrowhead=empty, style=dashed, arrowsize=1.2, color="#A7B3C2"];
"MultaFijaDiaria" -> "PoliticaMulta" [arrowhead=empty, style=dashed, arrowsize=1.2];
"MultaProgresiva" -> "PoliticaMulta" [arrowhead=empty, style=dashed, arrowsize=1.2];
"RepositorioMemoria" -> "Repositorio" [arrowhead=empty, style=dashed, arrowsize=1.2];
"Ejemplar" -> "MaterialBibliografico" [arrowhead=diamond, arrowsize=1.4, taillabel="1..*", headlabel="1", label=" ejemplares"];
"Autor" -> "Libro" [arrowhead=odiamond, arrowsize=1.4, taillabel="1..*", headlabel="*", label=" autores"];
"Multa" -> "Prestamo" [arrowhead=diamond, arrowsize=1.4, taillabel="0..1", headlabel="1", label=" multa"];
"Socio" -> "Prestamo" [arrowhead=vee, taillabel="1", headlabel="0..*", label=" historial"];
"Prestamo" -> "Ejemplar" [arrowhead=vee, taillabel="*", headlabel="1", label=" presta"];
"Prestamo" -> "Bibliotecario" [arrowhead=vee, taillabel="*", headlabel="1", label=" registrado por"];
"Ejemplar" -> "EstadoEjemplar" [arrowhead=vee, taillabel="", headlabel="1", label=""];
"Prestamo" -> "EstadoPrestamo" [arrowhead=vee, style=dashed, label=" «calcula»", color="#7A8796", fontcolor="#7A8796"];
"Prestamo" -> "PoliticaMulta" [arrowhead=vee, style=dashed, label=" «usa»", color="#7A8796", fontcolor="#7A8796"];
"RepositorioMemoria" -> "Biblioteca" [arrowhead=diamond, arrowsize=1.4, taillabel="5", headlabel="1", label=" repositorios"];
"Biblioteca" -> "PoliticaMulta" [arrowhead=vee, taillabel="", headlabel="1", label=" política vigente"];
"BibliotecaListener" -> "Biblioteca" [arrowhead=odiamond, arrowsize=1.4, taillabel="0..*", headlabel="1", label=" observadores"];
"GestorPersistencia" -> "Biblioteca" [arrowhead=vee, style=dashed, label=" «serializa»", color="#7A8796", fontcolor="#7A8796"];
"Biblioteca" -> "OperacionInvalidaException" [arrowhead=vee, style=dashed, label=" «throws»", color="#7A8796", fontcolor="#7A8796"];
"Repositorio" -> "Identificable" [arrowhead=vee, style=dashed, label=" T extends", color="#7A8796", fontcolor="#7A8796"];
legend [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" COLOR="#9AA8B8"><TR><TD COLSPAN="2"><B>Referencias</B></TD></TR>
<TR><TD ALIGN="LEFT">——▷</TD><TD ALIGN="LEFT">Herencia (generalización)</TD></TR>
<TR><TD ALIGN="LEFT">- - -▷</TD><TD ALIGN="LEFT">Implementa interfaz (realización)</TD></TR>
<TR><TD ALIGN="LEFT">——◆</TD><TD ALIGN="LEFT">Composición (la parte no existe sin el todo)</TD></TR>
<TR><TD ALIGN="LEFT">——◇</TD><TD ALIGN="LEFT">Agregación (la parte existe por sí misma)</TD></TR>
<TR><TD ALIGN="LEFT">——&gt;</TD><TD ALIGN="LEFT">Asociación navegable</TD></TR>
